# OpenAI credentials - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Chat model used for question rewriting and answer generation
MODEL_NAME=gpt-4o-mini

# Embedding model used for indexing and retrieval
# NOTE: if you change this, delete the vector store and re-run ingestion
EMBEDDING_MODEL=text-embedding-3-small

# Directory where the Chroma vector store is persisted
CHROMA_DB_DIR=app/db/chroma

# Path to the source handbook PDF
PDF_PATH=data/handbook.pdf
